thubusercontent.com/78643629/459784496-a3f647c6-843b-47b1-a59c-d35f6ab8e8c0.png?jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lVUiSYFziIFOxifoFIwI8duYxo5n2V6yUL20ZutTmpY\" alt=\"이미지\">\u003C/p>\n\u003Ch2 id=\"4-project-settings\">4. Project Settings\u003C/h2>\n\u003Cp>ㅋㅋ\r\n\u003Cimg src=\"https://private-user-images.githubusercontent.com/78643629/459784496-a3f647c6-843b-47b1-a59c-d35f6ab8e8c0.png?jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lVUiSYFziIFOxifoFIwI8duYxo5n2V6yUL20ZutTmpY\" alt=\"이미지\">\u003C/p>\n\u003Ch3 id=\"4-1-graphics\">4-1. Graphics\u003C/h3>\n\u003Cp>아ㅣㅁ넝ㅁ나ㅣㅓㅇㅁ나ㅣㅇ;ㅣ마;ㄴ어ㅏㅣㅁ너아ㅣㅁ너ㅏㅣ너마ㅣ  ㅁㄴㅇㅁㄴㄴㅁㅇㄴㅁㅇㅁㄴㅇㅁㄴㅇㅁsㄴㅇㅁㄴㅇㅁㄴㅇㅁㄴㅇㅁㄴㅇㅁㄴㅇㅁㄴㅇㅁㄴ ㄹㅁ나러마ㅣ ㅏㅣㅁ너아ㅣㅁ너아ㅣㅁㄴ어\u003C/p>\n\u003Cp>띄어쓰기 테스트 etet\u003C/p>\n\u003Cp>ㅁㄴ아ㅓㅁ니ㅏㅇ\u003C/p>\n\u003Cp>\u003Cimg src=\"https://private-user-images.githubusercontent.com/78643629/459784496-a3f647c6-843b-47b1-a59c-d35f6ab8e8c0.png?jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lVUiSYFziIFOxifoFIwI8duYxo5n2V6yUL20ZutTmpY\" alt=\"이미지\">\u003C/p>\n\u003Ch3 id=\"4-2-input-system\">4-2 Input System\u003C/h3>\n\u003Cp>퇴근\r\n\u003Cimg src=\"https://private-user-images.githubusercontent.com/78643629/459784496-a3f647c6-843b-47b1-a59c-d35f6ab8e8c0.png?jwt=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lVUiSYFziIFOxifoFIwI8duYxo5n2V6yUL20ZutTmpY\" alt=\"이미지\">\u003C/p>",{"headings":152,"localImagePaths":171,"remoteImagePaths":172,"frontmatter":173,"imagePaths":175},[153,156,159,162,165,168],{"depth":107,"slug":154,"text":155},"1-inspector","1. Inspector",{"depth":107,"slug":157,"text":158},"2-game","2. Game",{"depth":107,"slug":160,"text":161},"3-hireachy","3. Hireachy",{"depth":107,"slug":163,"text":164},"4-project-settings","4. Project Settings",{"depth":111,"slug":166,"text":167},"4-1-graphics","4-1. Graphics",{"depth":111,"slug":169,"text":170},"4-2-input-system","4-2 Input System",[],[],{"title":140,"tags":174,"upload":145},[142,143,144],[],"unity-study/hello-unity.md","cpp/constructor-and-destructor",{"id":177,"data":179,"body":183,"filePath":184,"digest":185,"rendered":186,"legacyId":206},{"title":180,"tags":181,"upload":182},"객체의 시작과 끝 - 생성자와 소멸자",[27],"2025-07-07","## 개요\r\n\r\n> 클래스 속 함수를 맴버 함수라고 한다.\r\n클래스의 목적에 따라 기능과 호출시점을 생각해서 자유롭게 맴버 함수를 정의할 수 있는데\r\n이와는 다르게 좀 특별한 함수가 있다.\r\n\r\n바로 포스트의 주제인 \"**생성자**\"와 \"**소멸자**\"이다.\r\n둘은 각각 **객체의 시작과 끝**을 알리는 함수이다.\r\n\r\n## 생성자와 소멸자의 기본 형태\r\n\r\n아래는 생성자와 소멸자를 선언, 정의하는 예제이다.\r\n```cpp\r\nclass Knight\r\n{\r\npublic:\r\n    Knight(); // 생성자 선언\r\n    ~Knight(); // 소멸자 선언 (이름 앞 '~')\r\n\r\n    void Move(int x, int y);\r\n\r\npublic:\r\n    int x;\r\n    int y;\r\n}\r\n\r\nKnight::Knight() // 생성자 정의\r\n{\r\n\r\n}\r\n\r\nKnight::~Knight() // 소멸자 정의\r\n{\r\n\r\n}\r\n```\r\n일반적인 함수를 선언하는 것과 비슷하다.\r\n우선 일반적인 함수와 다르게 반환 형식을 지정하지 않는다. ~~(void도 아니다.)~~\r\n생성자와 소멸자는 클래스와 동일한 이름으로 선언하고, 소멸자 앞에는 꼭 '*~*'를 붙여야 한다.\r\n\r\n소멸자는 클래스별 단 하나만 선언할 수 있지만 생성자는 다양한 방법으로 여러개 선언이 가능하다.\r\n\r\n## 생성자 종류\r\n1. 기본생성자\r\n2. 복사생성자\r\n3. \r\n\r\n## 접근 제어자에 따른 생성자와 소멸자\r\n일반적으로 public에 선언하지만 상황에 따라 다르게 쓰는 것도 가능하다.\r\n\r\n아래 표에 접근 제어자에 따른 생성자와 소멸자의 용도를 정리하였다. \r\n\r\n|접근 제어자|생성자|소멸자|용도|\r\n|-----|---|---|---|\r\n|public|일반적인 객체 생성|기본 소멸 가능|대부분의 경우|\r\n|protected|상속 전용 객체 생성|자식 전용 파괴|추상 클래스, 인터페이스|\r\n|private|외부 생성 제한|외부 소멸 제한|싱글턴, 팩토리, 자원 통제|","src/content/posts/cpp/constructor-and-destructor.md","e46e2e63e5062b36",{"html":187,"metadata":188},"\u003Ch2 id=\"개요\">개요\u003C/h2>\n\u003Cblockquote>\n\u003Cp>클래스 속 함수를 맴버 함수라고 한다.\r\n클래스의 목적에 따라 기능과 호출시점을 생각해서 자유롭게 맴버 함수를 정의할 수 있는데\r\n이와는 다르게 좀 특별한 함수가 있다.\u003C/p>\n\u003C/blockquote>\n\u003Cp>바로 포스트의 주제인 “\u003Cstrong>생성자\u003C/strong>”와 “\u003Cstrong>소멸자\u003C/strong>”이다.\r\n둘은 각각 \u003Cstrong>객체의 시작과 끝\u003C/strong>을 알리는 함수이다.\u003C/p>\n\u003Ch2 id=\"생성자와-소멸자의-기본-형태\">생성자와 소멸자의 기본 형태\u003C/h2>\n\u003Cp>아래는 생성자와 소멸자를 선언, 정의하는 예제이다.\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"cpp\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">class\u003C/span>\u003Cspan style=\"color:#B392F0\"> Knight\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">public:\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">    Knight\u003C/span>\u003Cspan style=\"color:#E1E4E8\">();\u003C/span>\u003Cspan style=\"color:#6A737D\"> // 생성자 선언\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">    ~Knight\u003C/span>\u003Cspan style=\"color:#E1E4E8\">();\u003C/span>\u003Cspan style=\"color:#6A737D\"> // 소멸자 선언 (이름 앞 '~')\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">    void\u003C/span>\u003Cspan style=\"color:#B392F0\"> Move\u003C/span>\u003Cspan style=\"color:#E1E4E8\">(\u003C/span>\u003Cspan style=\"color:#F97583\">int\u003C/span>\u003Cspan style=\"color:#FFAB70\"> x\u003C/span>\u003Cspan style=\"color:#E1E4E8\">, \u003C/span>\u003Cspan style=\"color:#F97583\">int\u003C/span>\u003Cspan style=\"color:#FFAB70\"> y\u003C/span>\u003Cspan style=\"color:#E1E4E8\">);\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">public:\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">    int\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> x;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">    int\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> y;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">}\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">Knight\u003C/span>\u003Cspan style=\"color:#E1E4E8\">::\u003C/span>\u003Cspan style=\"color:#B392F0\">Knight\u003C/span>\u003Cspan style=\"color:#E1E4E8\">()\u003C/span>\u003Cspan style=\"color:#6A737D\"> // 생성자 정의\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">}\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">Knight\u003C/span>\u003Cspan style=\"color:#E1E4E8\">::\u003C/span>\u003Cspan style=\"color:#F97583\">~\u003C/span>\u003Cspan style=\"color:#B392F0\">Knight\u003C/span>\u003Cspan style=\"color:#E1E4E8\">()\u003C/span>\u003Cspan style=\"color:#6A737D\"> // 소멸자 정의\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">{\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">}\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cp>일반적인 함수를 선언하는 것과 비슷하다.\r\n우선 일반적인 함수와 다르게 반환 형식을 지정하지 않는다. \u003Cdel>(void도 아니다.)\u003C/del>\r\n생성자와 소멸자는 클래스와 동일한 이름으로 선언하고, 소멸자 앞에는 꼭 ’\u003Cem>~\u003C/em>‘를 붙여야 한다.\u003C/p>\n\u003Cp>소멸자는 클래스별 단 하나만 선언할 수 있지만 생성자는 다양한 방법으로 여러개 선언이 가능하다.\u003C/p>\n\u003Ch2 id=\"생성자-종류\">생성자 종류\u003C/h2>\n\u003Col>\n\u003Cli>기본생성자\u003C/li>\n\u003Cli>복사생성자\u003C/li>\n\u003Cli>\u003C/li>\n\u003C/ol>\n\u003Ch2 id=\"접근-제어자에-따른-생성자와-소멸자\">접근 제어자에 따른 생성자와 소멸자\u003C/h2>\n\u003Cp>일반적으로 public에 선언하지만 상황에 따라 다르게 쓰는 것도 가능하다.\u003C/p>\n\u003Cp>아래 표에 접근 제어자에 따른 생성자와 소멸자의 용도를 정리하였다.\u003C/p>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth>접근 제어자\u003C/th>\u003Cth>생성자\u003C/th>\u003Cth>소멸자\u003C/th>\u003Cth>용도\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd>public\u003C/td>\u003Ctd>일반적인 객체 생성\u003C/td>\u003Ctd>기본 소멸 가능\u003C/td>\u003Ctd>대부분의 경우\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>protected\u003C/td>\u003Ctd>상속 전용 객체 생성\u003C/td>\u003Ctd>자식 전용 파괴\u003C/td>\u003Ctd>추상 클래스, 인터페이스\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd>private\u003C/td>\u003Ctd>외부 생성 제한\u003C/td>\u003Ctd>외부 소멸 제한\u003C/td>\u003Ctd>싱글턴, 팩토리, 자원 통제\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>",{"headings":189,"localImagePaths":201,"remoteImagePaths":202,"frontmatter":203,"imagePaths":205},[190,192,195,198],{"depth":107,"slug":191,"text":191},"개요",{"depth":107,"slug":193,"text":194},"생성자와-소멸자의-기본-형태","생성자와 소멸자의 기본 형태",{"depth":107,"slug":196,"text":197},"생성자-종류","생성자 종류",{"depth":107,"slug":199,"text":200},"접근-제어자에-따른-생성자와-소멸자","접근 제어자에 따른 생성자와 소멸자",[],[],{"title":180,"tags":204,"upload":182},[27],[],"cpp/constructor-and-destructor.md","cpp/class",{"id":207,"data":209,"body":212,"filePath":213,"digest":214,"rendered":215,"legacyId":224},{"title":210,"tags":211,"upload":182},"객체지향과 클래스",[27],"설계도 안에 변수와 함수가 함께 들어갈 수 있다.\r\n\r\n```cpp\r\nclass Knight\r\n{\r\npublic:\r\n    // 맴버 함수 선언\r\n    void Move(int y, int x);\r\n    void Attack();\r\n    \r\n    // 맴버함수를 한 번에 정의 할 수 있다.\r\n    void Die()\r\n    {\r\n        hp = 0;\r\n        cout \u003C\u003C \"Die\" \u003C\u003C endl;\r\n    }\r\n\r\npublic:\r\n    // 맴버 변수\r\n    int hp;\r\n    int attack;\r\n    int posY;\r\n    int posX;\r\n}\r\n\r\n// 맴버 함수를 따로 정의할 수 있다.\r\n// 맴버 함수에서 맴버 변수를 사용할 수 있다.\r\nvoid Knight::Move(int y, int x)\r\n{\r\n    posY = y;\r\n    posX = x;\r\n    cout \u003C\u003C \"Move 정의\";\r\n}\r\n\r\nvoid Knight:: Attack()\r\n{\r\n    cout \u003C\u003C \"Attack 정의\";\r\n}\r\n```\r\n\r\n\r\n```cpp\r\nclass Knight { /* 생략 */ }\r\n\r\nint main()\r\n{\r\n    // Instantiate: 객체를 만드는 것.\r\n    Knight k1;\r\n    k1.hp = 100;\r\n    k1.attack = 10;\r\n    k1.posY = 0;\r\n    k1.posX = 0;\r\n\r\n    Knight k2;\r\n    k2.hp = 2000;\r\n    k2.attack = 110;\r\n    k2.posY = 20;\r\n    k2.posX = 10;\r\n\r\n    k1.Move(10, 10);\r\n    k1.Attack();\r\n    k1.Die();\r\n}\r\n```","src/content/posts/cpp/class.md","12fa498f9646aaac",{"html":216,"metadata":217},"\u003Cp>설계도 안에 변수와 함수가 함께 들어갈 수 있다.\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;co