{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strict": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "src",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    "src",
    "**/*.astro",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}