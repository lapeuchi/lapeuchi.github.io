---
import '@/styles/baseLayout.css';
import '@/styles/navbar.css';
import '@/styles/sidebar.css';
import Sidebar from '@/components/bodies/sidebar.astro';
import Navbar from '@/components/bodies/navbar.astro';
import MathJax from '@/components/heads/mathJax.astro';
import Bootstrap from '@/components/heads/bootstrap.astro';
import Theme from '@/components/heads/themeSettings.astro'

import { getPostStructure } from '@/utils/post';
const { title, description } = Astro.props;

const tabTitle = title?  title + " | Lapeuchi's Devlog" : "Lapeuchi's Devlog";

const seriesMap = await getPostStructure();
---

<html lang="ko">

  <head>
    <!-- 테마 적용 -->
    <Theme />
    
    <!-- bootstrap cdn -->
    <Bootstrap />
    
    <!-- 수학 수식 표현 -->
    <MathJax />

    <!-- 구글 애드센스 -->
    <meta name="google-adsense-account" content="ca-pub-3865242689879019">
   
    <!-- 구글 서치콘솔 -->
    <meta name="google-site-verification" content="MwfqsNGEL4f3sWJ8YANsgk5tO7IOgc_UVKIDhZC12r4" />
    
    <!-- 기본 설정 -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description} />
    <title>{tabTitle}</title>
    
  </head>

  <body>
    <!-- 넓을 땐 사이드바 -->
    <div class="sidebar-only">
      <Sidebar seriesMap={seriesMap} />
    </div>

    <!-- 좁을 땐 네비바 -->
    <div class="navbar-only">
      <Navbar />
    </div>

    <main>
      <slot />
    </main>
  
  </body>
  
</html>
