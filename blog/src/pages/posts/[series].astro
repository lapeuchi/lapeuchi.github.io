---
import BaseLayout from '@/layouts/baseLayout.astro';
import './[series].css';

import { getPostsBySeries, getSeriesData } from '@/lib/utils/post';
import { getAllSeriesPaths } from '@/lib/utils/staticPaths';

const { params } = Astro;
const seriesId = params.series;

const seriesMeta = getSeriesData(seriesId) ?? { title: seriesId, description: '' };
const posts = await getPostsBySeries(seriesId);

export async function getStaticPaths() {
  return getAllSeriesPaths();
}
---

<BaseLayout>
  
  <div class="head">
    <div class="title">
      <h2>📁 {seriesMeta.title}</h2>
      <span class="postLength">- {posts.length}개의 게시물</span>
    </div>
  
    <p class="description">{seriesMeta.description}</p>
  </div>
  
  <hr class="line">

  {posts.map(post => (
    <div class="card bg-dark text-white mb-3">
      <div class="card-body">
        <a href={`/posts/${seriesId}/${post.slug}`} class="h5 text-white text-decoration-none">
          {post.title}
        </a>
        <div class="mt-1">
          {post.tags.map(tag => (
            <span class="badge bg-light text-dark me-1">#{tag}</span>
          ))}
        </div>
        <div class="text-white text-end small">
          {post.date}
        </div>
      </div>
    </div>
  ))}
  
</BaseLayout>
