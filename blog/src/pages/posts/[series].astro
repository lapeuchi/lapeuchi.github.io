---
import BaseLayout from '@/layouts/baseLayout.astro';
import '@/styles/[series].css';

import { getSeriesData } from '@/lib/utils/post';
import { getAllSeriesPaths } from '@/lib/utils/staticPaths';

const { params } = Astro;
const seriesId = params.series;

const seriesData = await getSeriesData(seriesId);

export async function getStaticPaths() {
  return getAllSeriesPaths();
}
---
<title>lapeuchi's DevLog - {seriesData.title}</title>

<BaseLayout>
  <section class="series-header container">
    <div class="series-header__title">
      <h2>📁 {seriesData.title}</h2>
      <span class="series-header__count">- {seriesData.posts.length}개의 게시물</span>
    </div>

    {seriesData.description && (
      <p class="series-header__description text-secondary">
        {seriesData.description}
      </p>
    )}
  </section>

  <hr class="series-divider mb-4" />

  <section class="series-posts container">
    {seriesData.posts.map(post => (
      <div class="card bg-dark text-white mb-3">
        <div class="card-body">
          <a href={`/posts/${seriesId}/${post.slug}`} class="h5 text-white text-decoration-none">
            {post.title}
          </a>

          {post.tags.length > 0 && (
            <div class="mt-1">
              {post.tags.map(tag => (
                <span class="badge bg-light text-dark me-1">#{tag}</span>
              ))}
            </div>
          )}

          <div class="text-end small text-light" style="opacity: 0.6;">
            {post.date}
          </div>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>