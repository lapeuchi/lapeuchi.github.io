---
import BaseLayout from '@/layouts/baseLayout.astro';
import '@/styles/[series].css';

import { getSeriesData } from '@/utils/post';
import { getAllSeriesPaths } from '@/utils/staticPaths';

const { params } = Astro;
const seriesId = params.series;

const seriesData = await getSeriesData(seriesId);

export async function getStaticPaths() {
  return getAllSeriesPaths();
}
---
<BaseLayout title={seriesData.title} description={seriesData.description}>
  <div class="head">
    <h2 class="title">📁 {seriesData.title}</h2>

    {seriesData.description && (
      <p class="description">
        {seriesData.description}
      </p>
    )}
  </div>

  <section class="posts">
    <div class="postLength">- 게시물 {seriesData.posts.length}개</div>
    
    {seriesData.posts.map(post => (
      <div class="post">
        
          <a href={`/posts/${seriesId}/${post.slug}`} class="h5 text-white text-decoration-none">
            {post.title}
          </a>

          {post.tags.length > 0 && (
            <div class="mt-1">
              {post.tags.map(tag => (
                <span class="badge bg-light text-dark me-1">{tag}</span>
              ))}
            </div>
          )}

          <div class="upload">
            {post.date}
          </div>
        
      </div>
    ))}
  </section>
</BaseLayout>