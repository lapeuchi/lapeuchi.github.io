---
import BaseLayout from '@/layouts/baseLayout.astro';
import { getAllPostPaths } from '@/utils/staticPaths';
import { extractHeadings } from '@/utils/extractHeadings';
import { getPostData } from '@/utils/post';

import '@/styles/[slug].css'
import '@/styles/slug/markdown.css'

export async function getStaticPaths() {
  return getAllPostPaths();
}

const { series, slug } = Astro.params;
const post = await getPostData(series, slug);

const rendered = await post.render();
const { Content } = rendered;
const { body } = post;
const data = post.data;
const headings = extractHeadings(body);
---

<BaseLayout title={data.title} description={data.title}>  
  <h1 class="title">{data.title}</h1>  
  <span class="upload">{data.upload}</span>

  <div class="tags">
    {data.tags?.map(tag => (
      <span class="tag badge text-dark">{tag}</span>
    ))}
  </div>
  
  {headings.length > 0 && (
    <div class="index">
      <h5 class="text-white">📑 목차</h5>
      <ul>
        {headings.map(({ level, id, text }) => (
          <li class={`level-${level}`}>
            <a href={`#${id}`}>{text}</a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <article class="markdown-body">
    <Content />
  </article>


  
</BaseLayout>
