---
import BaseLayout from '@/layouts/baseLayout.astro';
import { getAllPostPaths } from '@/lib/utils/staticPaths';
import { getEntry } from 'astro:content';
import { extractHeadings } from '@/lib/utils/extractHeadings';
import './[slug].css'

export async function getStaticPaths() {
  return getAllPostPaths();
}

const { series, slug } = Astro.params;
const slugPath = `${series}/${slug}`;
const post = await getEntry('posts', slugPath);
const rendered = await post.render();

const { Content } = rendered;
const { data, body } = post;
const headings = extractHeadings(body);

---
<head>
<title>lapeuchi's DevLog - {data.title}</title>
</head>

<BaseLayout>
  <div class="container mt-5">
    <h1 class="mb-2">{data.title}</h1>

    <div class="mb-3">
      {data.tags?.map(tag => (
        <span class="badge bg-light text-dark me-1">#{tag}</span>
      ))}
    </div>

    {headings.length > 0 && (
      <div class="toc mb-4">
        <h5 class="text-white">📑 목차</h5>
        <ul>
          {headings.map(({ level, id, text }) => (
            <li class={`level-${level}`}>
              <a href={`#${id}`}>{text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <hr />

    <article class="markdown-body">
      <Content />
    </article>

  </div>

  
</BaseLayout>
