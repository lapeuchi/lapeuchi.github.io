---
import BaseLayout from '@/layouts/baseLayout.astro';
import { getAllPostPaths } from '@/lib/utils/staticPaths';
import { extractHeadings } from '@/lib/utils/extractHeadings';
import { getPostData } from '@/lib/utils/post'; // ✅ 기존 함수 재사용

import '@/styles/[slug].css'


export async function getStaticPaths() {
  return getAllPostPaths();
}

const { series, slug } = Astro.params;
const post = await getPostData(series, slug);

const rendered = await post.render();
const { Content } = rendered;
const { body } = post;
const data = post.data as { title: string; tags?: string[] };
const headings = extractHeadings(body);
---

<title>lapeuchi's DevLog - {data.title}</title>

<BaseLayout>
  
  <h1 class="title">{data.title}</h1>

  <div class="tags">
    {data.tags?.map(tag => (
      <span class="tag badge text-dark">#{tag}</span>
    ))}
  </div>

  {headings.length > 0 && (
    <div class="index">
      <h5 class="text-white">📑 목차</h5>
      <ul>
        {headings.map(({ level, id, text }) => (
          <li class={`level-${level}`}>
            <a href={`#${id}`}>{text}</a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <hr />

  <article class="markdown-body">
    <Content />
  </article>


  
</BaseLayout>
