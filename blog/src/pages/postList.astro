---
import BaseLayout from '@/layouts/baseLayout.astro';
import { getPostStructure } from '@/lib/utils/post';

const seriesMap = await getPostStructure();
---

<BaseLayout>

  <h2 class="mb-4">📚 게시글 목록</h2>

  {Object.entries(seriesMap).map(([slug, series]) => (
    <div class="card bg-dark text-white mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <a href={`/posts/${slug}`} class="text-decoration-underline text-white">
          {series.title}
        </a>
        <span>({series.posts.length})</span>
      </div>

      <ul class="list-group list-group-flush">
        {series.posts.map((post) => (
          <li class="list-group-item bg-secondary text-white d-flex justify-content-between flex-wrap align-items-start">
            <a href={`/posts/${slug}/${post.slug}`} class="me-auto text-white text-decoration-none">
              {post.title}
            </a>
            <div class="text-end small">
              {post.tags.length > 0 && (
                <div class="mb-1">
                  {post.tags.map((tag) => (
                    <span class="badge bg-light text-dark me-1">#{tag}</span>
                  ))}
                </div>
              )}
              <div style="font-size: 0.8rem; color: #ccc;">
                {post.date}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}

</BaseLayout>