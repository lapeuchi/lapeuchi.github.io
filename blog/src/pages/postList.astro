---
import '@/styles/postList.css';
import BaseLayout from '@/layouts/baseLayout.astro';

import { getPostStructure } from '@/utils/post';

const seriesMap = await getPostStructure();
---
<title>lapeuchi's DevLog - 게시물</title>
<BaseLayout>
  
  <h2 class="title">📚 게시글 목록</h2>

  {Object.entries(seriesMap).map(([slug, series]) => (
    <div class="card bg-dark text-white mb-3">
      <div
        class="card-header d-flex justify-content-between align-items-center"
        style="cursor: pointer;"
        onclick={`document.getElementById('posts-${slug}').classList.toggle('d-none')`}
      >
        <div class="d-flex align-items-baseline gap-2 flex-wrap">
          <a href={`/posts/${slug}`} class="seriesName">
            {series.title}
          </a>

          {series.description && (
            <small class="series-description">
              {series.description}
            </small>
          )}
        </div>
        <span class="postsCount">({series.posts.length})</span>
      </div>

      <ul id={`posts-${slug}`} class="list-group list-group-flush d-none">
        {series.posts.map((post) => (
          <li class="list-group-item bg-secondary text-white d-flex justify-content-between flex-wrap align-items-start">
            <a href={`/posts/${slug}/${post.slug}`} class="postName">
              {post.title}
            </a>
            <div class="text-end small">
              {post.tags.length > 0 && (
                <div class="mb-1">
                  {post.tags.map((tag) => (
                    <span class="badge bg-light text-dark me-1">#{tag}</span>
                  ))}
                </div>
              )}
              <div style="font-size: 0.8rem; color: #ccc;">
                {post.date}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</BaseLayout>
