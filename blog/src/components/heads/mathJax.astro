---
// 수식 표현 설정
---

<script is:inline>
  window.MathJax = {
    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],
      tags: 'none' // 수식 넘버 제거
    },
    svg: {
      fontCache: 'global'
    },
    startup: {
      typeset: true
    }
  };
</script>

<script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>