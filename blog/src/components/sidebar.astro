---
import snsList from '../data/sidebarSNS.json';
import type { SeriesMap } from '@/utils/post';

const props = Astro.props as { seriesMap: SeriesMap };
const { seriesMap } = props;
---

<div class="sidebar">
  <!-- 프로필 -->

  <div class="profile">
    <img class ="profileImg" src="/assets/profile.jpg" alt="프사"/>
    <h5 class="nickname" id="themeToggle"></h5>
    
    <span class="email"> 
      <a href="mailto:lapeuchi@email.com">
        lapeuchi@email.com
      </a>
    </span>
    
    <div class="sns-icons row row-cols-3 g-2">
      {snsList.map((sns) => (
        <div class="col text-center">
          <a href={sns.url} target="_blank" rel="noreferrer">
            <i class={`bi ${sns.icon}`}></i>
          </a>
        </div>
      ))}
    </div>
  </div>

  <hr />

  <div class="sidebar-menu">
    <h5 class="sidebar-head">페이지</h5>
    <ul>
      <li><a href="/">홈</a></li>
      <li><a href="/postList">게시물 목록</a></li>


      
    </ul>
  </div>

  <hr />

  <div class="sidebar-menu">
    <h5 class="sidebar-head">시리즈</h5>
    <ul>
      {Object.entries(seriesMap).map(([id, s]) => (
        <li>
          <a href={`/posts/${id}`}>
            {s.title} <small>({s.posts.length})</small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
